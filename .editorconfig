# Linux kernel coding style for C; see .clang-format and checkpatch.pl
root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

[*.{c,h}]
indent_style = tab
indent_size = 8
max_line_length = 80

[Makefile]
indent_style = tab

[*.{sh,py}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
